# Copie este archivo como .env antes de arrancar el proyecto.
# En GitHub Desktop el archivo .env no aparecera como cambio: esta ignorado a
# proposito, porque cada participante puede tener una direccion distinta.
#
# Toda variable que React deba leer tiene que empezar con VITE_.
# Si no empieza con VITE_, Vite no la expone y el valor llega vacio.

# Sesiones 4 y 5: backend local servido por json-server.
VITE_API_URL=http://localhost:3001

# Sesion 6: al desplegar, este valor se reemplaza por la URL de la API alojada.
# El codigo de la aplicacion no cambia en ninguna linea.
